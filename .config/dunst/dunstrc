[global]
    font = "Inter", "JetBrainsMono NF" 12
    width = 300
    padding = 20
    corner_radius = 16
    frame_width = 2
    background = "#191724"  
    foreground = "#e0def4"
    frame_color = "#c4a7e7"
    gap_size = 5

[urgency_low]
    timeout = 3
    frame_color = "#c4a7e7"   
    foreground = "#e0def4"   

[urgency_normal]
    timeout = 5
    frame_color = "#c4a7e7" 

[urgency_critical]
    timeout = 15
    foreground = "#eb6f92"  
    frame_color = "#eb6f92"
