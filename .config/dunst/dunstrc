[global]
    font = "Inter", "JetBrainsMono NF" 12
    width = 300
    padding = 20
    corner_radius = 16
    frame_width = 2
    background = "#141419"  
    foreground = "#cdd6f4"
    frame_color = "#2e3440"
    gap_size = 5

[urgency_low]
    timeout = 3
    frame_color = "#2e3440"   
    foreground = "#cdd6f4"   

[urgency_normal]
    timeout = 5
    frame_color = "#2e3440" 

[urgency_critical]
    timeout = 15
    foreground = "#f2cdcd" 
    frame_color = "#f2cdcd"
